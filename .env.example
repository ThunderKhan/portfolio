# Optional server-only credential for the contribution calendar.
# Copy to .env.local and fill locally; never commit the actual token.
GITHUB_TOKEN=

# Optional public canonical origin override (not a credential).
# NEXT_PUBLIC_SITE_URL=https://ayankhan.me

# Server-only release controls. Leave unset locally and in Preview.
# Set PORTFOLIO_PUBLIC_RELEASE=1 only in Vercel Production, after release approval.
# Vercel system variables VERCEL_ENV and VERCEL_GIT_COMMIT_REF must be exposed automatically.
# PORTFOLIO_PUBLIC_RELEASE=1
# Optional separate production telemetry opt-in (default off).
# PORTFOLIO_ENABLE_TELEMETRY=1
